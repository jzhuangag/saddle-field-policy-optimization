# Keep only the frozen paper-suite result directories named by the release
# manifest, together with the latest sentinel, tuning, and bridge audits.
/experiments/paper_suite_20260723/results/*
!/experiments/paper_suite_20260723/results/linear-geometry-20260723-103816/
!/experiments/paper_suite_20260723/results/tabular-exact-gap-20260723-113009/
