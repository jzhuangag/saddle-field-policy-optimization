# Keep only the formal finite-trajectory result and its latest sentinel audit.
/experiments/stochastic_oracle_validation_20260727/results/*
!/experiments/stochastic_oracle_validation_20260727/results/formal-CyclicControl-dice-20260727-124224/
!/experiments/stochastic_oracle_validation_20260727/results/sentinels-dice-20260728-142504/

